# ============================================================
# .gitignore - ruoyi_Interface 接口自动化框架
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ---------- 报告与日志（每次运行都会重新生成，不进版本库） ----------
reports/
logs/
*.log

# ---------- IDE ----------
.idea/

# ---------- 登录态 / 本地敏感信息 ----------
.auth/

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db

# ---------- 本地临时 / 数据库 ----------
*.db
*.sqlite3
*.tmp
